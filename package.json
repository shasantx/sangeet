{
  "name": "sangeet",
  "version": "2.3.0",
  "license": "MIT",
  "author": "Shasant <https://github.com/shasantx>",
  "homepage": "https://sangeet.shasant.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/shasantx/sangeet.git"
  },
  "private": true,
  "description": "Sangeet v2.3 — Free, open-source music discovery and streaming platform for Web, Android, and Windows (Rust).",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop": "electron .",
    "desktop:dist": "electron-builder --win portable",
    "desktop:rust": "cargo run --manifest-path desktop-rust/Cargo.toml",
    "desktop:rust:build": "cargo build --release --manifest-path desktop-rust/Cargo.toml",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "build": {
    "appId": "xyz.shasant.sangeet",
    "productName": "Sangeet",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/brand/sangeet-icon-512.png"
    }
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "glasskit-liquid-glass": "^2.0.0",
    "gsap": "^3.15.1",
    "lucide-react": "^0.468.0",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
