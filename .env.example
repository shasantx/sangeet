# Google Cloud OAuth 2.0 Web application
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
APP_URL=http://localhost:3000

# Generate a random value of at least 32 characters; keep private on the server.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional comma-separated Google email allowlist for /admin.
ADMIN_EMAILS=private.shasant@gmail.com

# Server-only user-management database credentials. Never use NEXT_PUBLIC_ here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Local ytmusicapi service. This client is unofficial; see README.md.
YTMUSIC_SERVICE_URL=http://127.0.0.1:8765
YTMUSIC_SERVICE_TOKEN=

# Reserved for future billing integration. No checkout is enabled in this build.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
