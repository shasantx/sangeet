# Optional Google OAuth 2.0 Web Application credentials
# Sangeet works 100% on-device in Guest & Local Profile mode without any database.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# Random 32+ character secret used to sign HTTP-only session cookies
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional: Jam (listen together). Create a free Supabase project and copy
# Settings -> API -> Project URL and the anon public key. Only Realtime
# broadcast/presence channels are used; no database tables are needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
